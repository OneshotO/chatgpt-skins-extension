{
  "manifest_version": 3,
  "name": "ChatGPT Skins",
  "version": "1.0",
  "description": "Customize the look of ChatGPT with beautiful themes!",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "images/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["scripts/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/*.css", "images/*", "voices/rick/*.mp3", "voices/morty/*.mp3", "voices/poopoo/*.mp3"],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ]
    }
  ]
}